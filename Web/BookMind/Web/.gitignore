## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leasePublic/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the TestResults folder
# [Tt]est[Rr]esults/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build log of MSBuild
*.apexlog
*.log

# Visual Studio 2017 AutoGenerated files
Generated\ Files/

# Guidance Automation Toolkit
*.gpState

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a .NET coding add-in
.JustCode

# TeamCity is a build add-in
_TeamCity*

# DotCover is a .NET coding add-in
*.dotCover

# AxoCover is a .NET coding add-in
.axoCover/*
!.axoCover/settings.json

# Visual Studio code coverage results
*.coverage
*.coveragexml

# MyGet is a package analysis add-in
_MyGet

# Koding is a .NET coding add-in
.koding.zsh

# Visual Studio Tooling for Unity
*.unityproj
*.unityproj.user
*.unityproj.userprefs

# Visual Studio AutoGenerated files
[Aa]pp[Pp]ackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkg.devrc
*.appx
*.appxbundle
*.appxrecipe

# Others
.DS_Store
.env
node_modules/
dist/
