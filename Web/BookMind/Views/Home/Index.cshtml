@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="display-5 fw-bold text-primary">Kütüphanenizi Keşfedin</h1>
        <p class="lead text-muted">Binlerce kitap arasından dilediğinizi seçin.</p>
    </div>
    <div class="col-md-4">
        <div class="input-group shadow-sm mt-3">
            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-primary"></i></span>
            <input type="text" class="form-control border-0" placeholder="Kitap veya yazar ara..." id="search-input">
        </div>
    </div>
</div>

<div class="row">
    <!-- Sidebar / Filters -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Kategoriler</h5>
                <div id="genre-filters" class="list-group list-group-flush">
                    <button class="list-group-item list-group-item-action active" data-genre="all">Tüm Kitaplar</button>
                    <!-- Genres will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-md-9">
        <div class="row" id="book-list">
            <!-- Books will be loaded here via JS -->
        </div>

        <!-- Pagination Section -->
        <div class="row mt-3 mb-5">
            <div class="col-12">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center" id="pagination">
                        <!-- Pagination buttons will be loaded here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
}
