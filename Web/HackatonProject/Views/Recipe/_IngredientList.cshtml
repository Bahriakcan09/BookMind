@model List<HackatonProject.Models.IngredientRequirement>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Malzeme</th>
                <th>Miktar</th>
                <th>Market Eşleşmesi</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="fw-bold">@item.Name</div>
                    </td>
                    <td>@item.Amount @item.Unit</td>
                    <td>
                        @if (item.MatchedProduct != null)
                        {
                            <div class="d-flex align-items-center">
                                <img src="@item.MatchedProduct.ImageUrl" alt="@item.MatchedProduct.Name" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                <div>
                                    <div class="small fw-bold text-dark">@item.MatchedProduct.Name</div>
                                    <div class="small text-success">@item.MatchedProduct.Price.ToString("C2")</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>Eşleşme Bulunamadı</span>
                        }
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
