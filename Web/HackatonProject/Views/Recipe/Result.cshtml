@model HackatonProject.Models.RecipeAnalysisResult
@{
    ViewData["Title"] = "Tarif Sonucu";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">@Model.RecipeName</h2>
            <p class="text-muted mb-4"><i class="bi bi-clock me-1"></i>Tahmini Hazırlık: @Model.PrepTime</p>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Gerekli Malzemeler</h5>
                    <div class="d-flex align-items-center">
                        <label class="me-2 small fw-bold">Porsiyon:</label>
                        <select id="portionSelect" class="form-select form-select-sm" style="width: 70px;">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="4" selected>4</option>
                            <option value="6">6</option>
                            <option value="10">10</option>
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    <div id="ingredientListContainer">
                        @await Html.PartialAsync("_IngredientList", Model.Ingredients)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Özet</h5>
                    <p class="small text-muted mb-4">Seçtiğiniz malzemeler otomatik olarak sepetinize eklenecektir. Evde olan ürünleri listeden çıkarabilirsiniz.</p>
                    
                    <button type="button" onclick="addAllToCart()" class="btn btn-primary w-100 py-2 fw-bold">
                        Hepsini Sepete Ekle
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link w-100 mt-2 text-decoration-none">Yeniden Analiz Et</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('portionSelect').addEventListener('change', function() {
        // Mock dynamic update for now
        // In reality, this would call UpdatePortion action via AJAX
        alert('Porsiyon güncelleniyor: ' + this.value);
    });

    function addAllToCart() {
        alert('Malzemeler sepetinize eklendi!');
        window.location.href = '@Url.Action("Cart", "Market")';
    }
</script>
