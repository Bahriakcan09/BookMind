@{
    ViewData["Title"] = "Tarif Analizi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center mb-5">
            <h2 class="fw-bold">Yapay Zeka ile Tarifini Çözümle</h2>
            <p class="text-muted">Bir fotoğraf yükle veya link paylaş, malzemeleri stoklarımızla eşleştirelim.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="mb-3 text-primary"><i class="bi bi-camera me-2"></i>Fotoğraf Yükle</h5>
                <form asp-action="Analyze" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="file" name="recipeImage" class="form-control" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Analiz Et</button>
                </form>
            </div>
        </div>

        <div class="col-md-1 d-flex align-items-center justify-content-center mb-4">
            <span class="badge bg-light text-dark p-2 border">VEYA</span>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="mb-3 text-success"><i class="bi bi-link-45deg me-2"></i>Link Yapıştır</h5>
                <form asp-action="Analyze" method="post">
                    <div class="mb-3">
                        <input type="url" name="recipeLink" class="form-control" placeholder="Instagram, YouTube veya Web linki..." required />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Linkten Analiz Et</button>
                </form>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-4 text-center">
            @ViewBag.Error
        </div>
    }
</div>
