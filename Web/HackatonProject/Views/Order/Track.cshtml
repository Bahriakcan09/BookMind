@model List<HackatonProject.Models.Order>
@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">Sipariş Takibi</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Henüz bir siparişiniz bulunmuyor.</div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Sipariş #@order.Id?.Substring(0, 8)</span>
                            <span class="badge @(order.Status == "Delivered" ? "bg-success" : "bg-warning text-dark")">@order.Status</span>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Tarih:</strong> @order.OrderDate.ToString("g")</p>
                            <p class="mb-1"><strong>Adres:</strong> @order.Address</p>
                            <p class="mb-3"><strong>Tutar:</strong> @order.TotalAmount.ToString("C2")</p>
                            
                            <h6 class="fw-bold small mb-2 text-muted">Ürünler:</h6>
                            <ul class="list-unstyled small">
                                @foreach (var item in order.Items)
                                {
                                    <li>@item.Quantity x @item.ProductName</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
