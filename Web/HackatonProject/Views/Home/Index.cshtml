@{
    ViewData["Title"] = "TarifMarket - Hoş Geldiniz";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">TarifMarket</h1>
    <p class="lead">Yemek tariflerinizi saniyeler içinde alışveriş sepetine dönüştürün.</p>
    
    <div class="row mt-5 justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-camera fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Fotoğraf Yükle</h5>
                    <p class="card-text text-muted">Yemeğin fotoğrafını çekin, malzemeleri biz analiz edelim.</p>
                    <a asp-controller="Recipe" asp-action="Index" class="btn btn-outline-primary">Hemen Başla</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-link-45deg fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Link Yapıştır</h5>
                    <p class="card-text text-muted">Instagram veya YouTube linkini verin, sepete ekleyelim.</p>
                    <a asp-controller="Recipe" asp-action="Index" class="btn btn-outline-success">Link ile Bul</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-cart3 fs-1 text-warning"></i>
                    <h5 class="card-title mt-3">Market Reyonu</h5>
                    <p class="card-text text-muted">Taze ürünlerimizi kendiniz inceleyip sepetinizi tamamlayın.</p>
                    <a asp-controller="Market" asp-action="Index" class="btn btn-outline-warning">Markete Git</a>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
