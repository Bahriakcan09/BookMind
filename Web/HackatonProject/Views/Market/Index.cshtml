@model List<HackatonProject.Models.Product>
@{
    ViewData["Title"] = "Market";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Market Reyonu</h2>
        <a asp-action="Cart" class="btn btn-warning fw-bold">
            <i class="bi bi-cart3 me-1"></i>Sepetim
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 180px; object-fit: cover;">
                    <div class="card-body">
                        <h6 class="card-title fw-bold mb-1">@product.Name</h6>
                        <p class="small text-muted mb-2">@product.Category</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold text-success fs-5">@product.Price.ToString("C2")</span>
                            <form asp-action="AddToCart" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
