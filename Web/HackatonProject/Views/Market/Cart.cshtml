@model HackatonProject.Models.Cart
@{
    ViewData["Title"] = "Sepetim";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">Alışveriş Sepeti</h2>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
            <h5 class="mt-3">Sepetiniz şu an boş.</h5>
            <a asp-action="Index" class="btn btn-primary mt-3">Alışverişe Başla</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Items)
                        {
                            <div class="list-group-item py-3">
                                <div class="row align-items-center">
                                    <div class="col-2">
                                        <img src="@item.ImageUrl" class="img-fluid rounded" alt="@item.ProductName">
                                    </div>
                                    <div class="col-5">
                                        <h6 class="mb-0 fw-bold">@item.ProductName</h6>
                                        <span class="text-muted small">Birim Fiyat: @item.Price.ToString("C2")</span>
                                    </div>
                                    <div class="col-2 text-center">
                                        <span class="fw-bold">@item.Quantity Adet</span>
                                    </div>
                                    <div class="col-2 text-end">
                                        <span class="fw-bold text-success">@((item.Price * item.Quantity).ToString("C2"))</span>
                                    </div>
                                    <div class="col-1 text-end">
                                        <form asp-action="RemoveFromCart" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-link text-danger p-0">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 p-4">
                    <h5 class="fw-bold mb-4">Sipariş Özeti</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Ara Toplam</span>
                        <span>@Model.TotalPrice.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Teslimat</span>
                        <span class="text-success">Ücretsiz</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Toplam</span>
                        <span class="fw-bold fs-5 text-primary">@Model.TotalPrice.ToString("C2")</span>
                    </div>

                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary w-100 py-3 fw-bold">
                        Ödemeye Geç
                    </a>
                </div>
            </div>
        </div>
    }
</div>
